{
  "_comment": "Portable template. Prefer scripts/install-claude-hooks.sh, which writes absolute commands for this checkout. If using this manually, set TOKEN_SAVIOR_ROOT before Claude starts.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$TOKEN_SAVIOR_ROOT/hooks/memory-session-start.sh\"",
            "timeout": 3000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$TOKEN_SAVIOR_ROOT/hooks/memory-userprompt.sh\"",
            "timeout": 3000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|View|NotebookRead|Edit|Write|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$TOKEN_SAVIOR_ROOT/hooks/memory-pretooluse.sh\"",
            "timeout": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|WebFetch|web_fetch|WebSearch|Read|Grep|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$TOKEN_SAVIOR_ROOT/hooks/memory-posttooluse.sh\"",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "python3 \"$TOKEN_SAVIOR_ROOT/hooks/tool_capture_hook.py\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$TOKEN_SAVIOR_ROOT/hooks/memory-precompact.sh\"",
            "timeout": 3000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$TOKEN_SAVIOR_ROOT/hooks/memory-session-stop.sh\" stop",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
